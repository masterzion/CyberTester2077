# Copy to credentials.yml (ignored by Git), then replace password_env values.
accounts:
  - name: "Mārtiņš Ozoliņš"
    role: "parent"
    description: "Elza Ozoliņa's father and primary guardian. Uses the parent experience to supervise Elza's learning, friends, messages, media, activity permissions, safety alerts, and family settings. May approve or reject child-related requests only within Elza's family; must not impersonate Elza, send messages as her, or access unrelated families."
    email: "martins.ozolins.1789417301825@example.test"
    password_env: "KIDVERSE_MARTINS_PASSWORD"
    runtest_web: true
    runtest_mobile: true
  - name: "Elza Ozoliņa"
    role: "child"
    description: "Mārtiņš Ozoliņš's daughter and Sofija Eglīte's approved friend. Uses the child experience for age-appropriate learning, activities, profile, approved friendships, supervised messages, and safe media/posts. Must not see parent, teacher, reviewer, or administrator controls, alter safety policy, or communicate outside permitted relationships."
    email: "elza.ozolina.1789417301825@example.test"
    password_env: "KIDVERSE_ELZA_PASSWORD"
    runtest_web: true
    runtest_mobile: true
  - name: "Līga Kalniņa"
    role: "parent"
    description: "Rihards Kalniņš's mother and guardian. Tests a second independent family approval path: she can review requests affecting Rihards, manage Rihards's permissions, and participate in mutual child-to-child approval workflows. She must not approve decisions on Elza's behalf or access the Ozoliņš family dashboard."
    email: "liga.kalnina.1789418033798@example.test"
    password_env: "KIDVERSE_LIGA_PASSWORD"
    runtest_web: true
    runtest_mobile: true
  - name: "Laura Bērziņa"
    role: "teacher"
    description: "DEV school teacher. Uses school and teaching workflows for assigned learners, groups, activities, and educational communication. Can review relevant class progress and publish permitted educational material, but must not access private family controls, guardian-only approvals, unrelated learner records, or administrator configuration."
    email: "laura.berzina.1789418081275@example.test"
    password_env: "KIDVERSE_LAURA_PASSWORD"
    runtest_web: true
    runtest_mobile: true
  - name: "DEV Root"
    role: "root"
    description: "Development root administrator with broad operational and account-management access. Tests administrative navigation, configuration visibility, account lifecycle controls, and cross-service observability. Destructive, irreversible, credential-changing, payment, and production-like actions remain out of automated exploratory scope and must be identified rather than executed."
    email: "admin.root.178941-admin@example.test"
    password_env: "KIDVERSE_ROOT_PASSWORD"
    runtest_web: true
    runtest_mobile: true
  - name: "DEV Review"
    role: "review"
    description: "Development safety-review administrator. Works from assigned moderation queues to inspect reported messages, images, posts, and advertising; records or selects permitted review outcomes and verifies auditability. Access must stay case-scoped and minimal: this role must not perform account administration, browse arbitrary child data, or act as a guardian or teacher."
    email: "admin.review.178941-admin@example.test"
    password_env: "KIDVERSE_REVIEW_PASSWORD"
    runtest_web: true
    runtest_mobile: true
  - name: "DEV Event Add"
    role: "event_add"
    description: "Development event editor. Creates and edits family or community event drafts, validates fields, schedules, localization, and audience rules, and submits work for the required approval flow. Must not independently publish, approve, delete, or bypass moderation when a separate approver is required."
    email: "admin.event-add.178941-admin@example.test"
    password_env: "KIDVERSE_EVENT_ADD_PASSWORD"
    runtest_web: true
    runtest_mobile: true
  - name: "Tomass Liepiņš"
    role: "child"
    description: "Anna Liepiņa and Jānis Liepiņš's son and Ilze Liepiņa's nephew. Uses a child account with multiple linked adults, allowing tests of parent/guardian visibility, permissions, activities, learning, messaging, and social safety. He must retain his own identity and must not expose adult dashboards or let any guardian impersonate him."
    email: "tomass.liepins.dev@example.test"
    password_env: "KIDVERSE_TOMASS_PASSWORD"
    runtest_web: true
    runtest_mobile: true
  - name: "Anna Liepiņa"
    role: "parent"
    description: "Tomass Liepiņš's mother with full active parent permissions. Can supervise Tomass's eligible activity, permissions, contacts, safety decisions, and relevant communication visibility. Tests the primary guardian workflow and must not gain authority over unrelated children or send or edit content as Tomass."
    email: "anna.liepins.dev@example.test"
    password_env: "KIDVERSE_ANNA_PASSWORD"
    runtest_web: true
    runtest_mobile: true
  - name: "Jānis Liepiņš"
    role: "parent"
    description: "Tomass Liepiņš's father with full active parent permissions. Represents a second guardian who should see the same authorized Tomass-specific controls while retaining individual audit identity and consent decisions. Must not receive universal household access, historical access beyond policy, or authority over unrelated families."
    email: "janis.liepins.dev@example.test"
    password_env: "KIDVERSE_JANIS_PASSWORD"
    runtest_web: true
    runtest_mobile: true
  - name: "Ilze Liepiņa"
    role: "parent"
    description: "Tomass Liepiņš's aunt with read-only guardian access. Can view only the Tomass-specific information explicitly granted by policy, including disclosed supervision where applicable. Must not approve requests, change permissions, publish, send as Tomass, alter settings, or access records outside her limited guardian scope."
    email: "ilze.liepins.dev@example.test"
    password_env: "KIDVERSE_ILZE_PASSWORD"
    runtest_web: true
    runtest_mobile: true
  - name: "Sofija Eglīte"
    role: "child"
    description: "Inese Eglīte's daughter and Elza Ozoliņa's approved friend. Uses child learning, activity, friendship, supervised messaging, posting, and media flows to test the second side of a child-to-child relationship. Must not bypass safety controls, discover arbitrary users, alter approval policy, or reach adult-only interfaces."
    email: "sofija.eglite.dev@example.test"
    password_env: "KIDVERSE_SOFIJA_PASSWORD"
    runtest_web: true
    runtest_mobile: true
  - name: "Inese Eglīte"
    role: "parent"
    description: "Sofija Eglīte's mother and guardian. Reviews Sofija-specific learning, friend, media, communication, activity, and safety workflows, including the guardian side of Sofija's relationship with Elza. Must only act for Sofija's family, respect cross-family approval boundaries, and never impersonate Sofija or access unrelated households."
    email: "inese.eglite.dev@example.test"
    password_env: "KIDVERSE_INESE_PASSWORD"
    runtest_web: true
    runtest_mobile: true
